# ASUS ROG Ryujin III (0b05:1aa2): bin/ryujin-lcd drives the 3.5" LCD over the cooler's
# hidraw node (interface 1, shared with the asus_rog_ryujin hwmon driver) and the raw USB
# device node for the vendor bulk interface 0. Both are root-only by default.
#
# TAG+="uaccess" is the portable way to grant access: systemd-logind puts an ACL on the node
# for whoever holds the active local session, on any distro. (GROUP="plugdev" is avoided; that
# group does not exist on Fedora, Bazzite, Arch and others, and a missing group breaks the rule.)
# For a headless box with no local session, add a group of your own here and join it.
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1aa2", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1aa2", MODE="0660", TAG+="uaccess"
